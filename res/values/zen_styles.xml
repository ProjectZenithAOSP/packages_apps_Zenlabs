<resources>
    <!-- Text Styles -->
    <style name="zenTextPrimary">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">@*android:string/config_headlineFontFamily</item>
    </style>

    <style name="zenTextPrimaryMedium" parent="zenTextPrimary">
        <item name="android:fontFamily">@*android:string/config_headlineFontFamilyMedium</item>
    </style>

    <style name="zenTextSecondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Dashboard -->
    <style name="zenDashboardPreferenceSingle" parent="zenPreferenceSingle">
        <item name="android:layout_marginBottom">0dp</item>
    </style>
    
    <style name="zenDashboardPreferenceTop" parent="zenPreferenceTop">
        <item name="android:layout_marginTop">@dimen/zen_pref_horizontal_padding</item>
    </style>

    <style name="zenDashboardPreferenceBottom" parent="zenPreferenceBottom">
        <item name="android:layout_marginBottom">0dp</item>
    </style>

    <style name="zenDashboardPreferenceFull" parent="zenPreferenceFull">
        <item name="android:layout_marginTop">@dimen/zen_pref_horizontal_padding</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="zenDashboardPreferenceFullAccent" parent="zenDashboardPreferenceFull">
        <item name="android:background">@drawable/zen_preference_background_full_accent</item>
    </style>

    <style name="zenDashboardPreferencePhone" parent="zenDashboardPreferenceTop">
        <item name="android:background">@drawable/zen_preference_background_phone</item>
    </style>

    <!-- General -->
    <style name="zenPreferenceSingle" parent="zenPreferenceBase">
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/zen_preference_background_single</item>
    </style>
    
    <style name="zenPreferenceBase">
        <item name="android:layout_marginStart">@dimen/zen_pref_horizontal_padding</item>
        <item name="android:layout_marginEnd">@dimen/zen_pref_horizontal_padding</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="zenPreferenceTop" parent="zenPreferenceBase">
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/zen_preference_background_top</item>
    </style>

    <style name="zenPreferenceMiddle" parent="zenPreferenceBase">
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">@drawable/zen_preference_background_middle</item>
    </style>

    <style name="zenPreferenceBottom" parent="zenPreferenceBase">
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/zen_preference_background_bottom</item>
    </style>

    <style name="zenPreferenceFull" parent="zenPreferenceBase">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/zen_preference_background_full</item>
    </style>

    <style name="zenPreferenceFullAccent" parent="zenPreferenceBase">
        <item name="android:layout_marginTop">@dimen/zen_pref_horizontal_padding</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/zen_preference_background_full_accent</item>
    </style>
</resources>
